<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trilha cinza -->
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.6"
            android:thickness="3.5dp"
            android:useLevel="false">
            <solid android:color="#E8EDF3" />
        </shape>
    </item>
    <!-- Arco vermelho (sweep) -->
    <item>
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.6"
            android:thickness="3.5dp"
            android:useLevel="false">
            <gradient
                android:type="sweep"
                android:startColor="#C6284A"
                android:centerColor="#00C6284A"
                android:endColor="#00E8EDF3" />
        </shape>
    </item>
</layer-list>
