{
  "name": "frontend",
  "version": "1.8.11",
  "scripts": {
    "prebuild": "node ./scripts/ensure-prod-env.mjs && node ./scripts/generate-version.mjs",
    "prestart": "node ./scripts/generate-version.mjs",
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "npx ng build",
    "watch": "ng build --watch --configuration development",
    "generate-version": "node ./scripts/generate-version.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "overrides": {
    "ws": "8.21.1",
    "uuid": "11.1.1",
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.12",
    "minimatch": "10.2.6",
    "glob": "13.0.6",
    "fast-uri": "3.1.8",
    "hono": "4.13.8",
    "ip-address": "10.7.2",
    "nanoid": "3.3.19",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "undici": "7.29.1",
    "baseline-browser-mapping": "2.11.25"
  },
  "dependencies": {
    "@angular/common": "21.2.23",
    "@angular/compiler": "21.2.23",
    "@angular/core": "21.2.23",
    "@angular/forms": "21.2.23",
    "@angular/platform-browser": "21.2.23",
    "@angular/router": "21.2.23",
    "bootstrap": "^5.3.8",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@types/bootstrap": "^5.2.10",
    "baseline-browser-mapping": "2.11.25",
    "typescript": "~5.9.2"
  }
}
